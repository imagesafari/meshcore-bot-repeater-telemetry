    {
      "type": "timeseries",
      "title": "Battery voltage and %",
      "description": "Battery % uses MeshCore's on-device formula: a straight line from 3.0 V (0%) to 4.2 V (100%), rounded down and clamped. Repeaters only report voltage, so the dashboard converts it. Above 4.2 V (e.g. while charging) % holds at 100 while voltage still moves. Pale yellow bands mark daylight (sunrise to sunset at the lat/lon variables, computed in the query with NOAA's solar formulas, within a few minutes). The % axis scales to the data in view.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 12
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": true,
                  "viz": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "meshcore_repeater_battery_volts{repeater=~\"$repeater\"}",
          "legendFormat": "{{repeater}}"
        },
        {
          "refId": "B",
          "expr": "clamp(floor((meshcore_repeater_battery_volts{repeater=~\"$repeater\"} * 1000 - 3000) * 100 / 1200), 0, 100)",
          "legendFormat": "{{repeater}} %"
        },
        {
          "refId": "C",
          "legendFormat": "daylight",
          "expr": "(((abs(((vector(time()) % 86400) / 3600) - (12 - ($lon) / 15 - (229.18 * (0.000075 + 0.001868 * cos((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.032077 * sin((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.014615 * cos(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.040849 * sin(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))))) / 60)) <= bool 12) * abs(((vector(time()) % 86400) / 3600) - (12 - ($lon) / 15 - (229.18 * (0.000075 + 0.001868 * cos((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.032077 * sin((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.014615 * cos(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.040849 * sin(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))))) / 60)) + (abs(((vector(time()) % 86400) / 3600) - (12 - ($lon) / 15 - (229.18 * (0.000075 + 0.001868 * cos((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.032077 * sin((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.014615 * cos(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.040849 * sin(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))))) / 60)) > bool 12) * (24 - abs(((vector(time()) % 86400) / 3600) - (12 - ($lon) / 15 - (229.18 * (0.000075 + 0.001868 * cos((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.032077 * sin((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.014615 * cos(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.040849 * sin(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))))) / 60)))) < bool (deg(acos((sin(rad(vector(-0.833))) - sin(rad(vector($lat))) * sin((0.006918 - 0.399912 * cos((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) + 0.070257 * sin((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.006758 * cos(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) + 0.000907 * sin(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.002697 * cos(3 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) + 0.00148 * sin(3 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24)))))) / (cos(rad(vector($lat))) * cos((0.006918 - 0.399912 * cos((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) + 0.070257 * sin((2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.006758 * cos(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) + 0.000907 * sin(2 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) - 0.002697 * cos(3 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24))) + 0.00148 * sin(3 * (2 * pi() / 365 * (day_of_year(vector(time())) - 1 + (((vector(time()) % 86400) / 3600) - 12) / 24)))))))) / 15))"
        }
      ],
      "id": 7
    },
