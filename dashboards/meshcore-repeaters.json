        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "meshcore_repeater_battery_volts{repeater=~\"$repeater\"}",
          "legendFormat": "{{repeater}}"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Noise floor",
