    {
      "type": "state-timeline",
      "title": "Charging / discharging (inferred)",
      "description": "Inferred from the battery voltage trend (slope over the last 2 h): Charging above +5 mV/h, Discharging below -5 mV/h, otherwise Flat / full (e.g. the charger holding a full battery). The Tower V2 has no charge-status signal, so this is an estimate, not a measurement.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{repeater}}",
          "expr": "(deriv(meshcore_repeater_battery_volts{repeater=~\"$repeater\"}[2h]) * 3600 * 1000 > bool 5) - (deriv(meshcore_repeater_battery_volts{repeater=~\"$repeater\"}[2h]) * 3600 * 1000 < bool -5)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Charging",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Flat / full",
                  "color": "blue",
                  "index": 1
                },
                "-1": {
                  "text": "Discharging",
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
