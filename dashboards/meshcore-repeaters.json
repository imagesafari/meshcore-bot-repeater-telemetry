{
  "uid": "meshcore-repeaters",
  "title": "MeshCore Repeaters",
  "description": "MeshCore repeater status and telemetry, polled over the air by the meshcore-bot repeater-telemetry plugin. Set the lat/lon variables (Dashboard settings > Variables) to your site for correct day/night shading.",
  "tags": [
    "meshcore",
    "radio"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "repeater",
        "label": "Repeater",
        "datasource": "Prometheus",
        "query": {
          "query": "label_values(meshcore_repeater_battery_volts, repeater)",
          "refId": "rep"
        },
        "definition": "label_values(meshcore_repeater_battery_volts, repeater)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "type": "constant",
        "name": "lat",
        "label": "Latitude",
        "hide": 2,
        "query": "51.4779",
        "current": {
          "text": "51.4779",
          "value": "51.4779"
        },
        "description": "Latitude of your site, decimal degrees (for day/night shading)"
      },
      {
        "type": "constant",
        "name": "lon",
        "label": "Longitude",
        "hide": 2,
        "query": "-0.0015",
        "current": {
          "text": "-0.0015",
          "value": "-0.0015"
        },
        "description": "Longitude of your site, decimal degrees (for day/night shading)"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Battery",
      "description": "",
